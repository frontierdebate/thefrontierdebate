// Cloudflare Workers configuration for The Frontier Debate.
{
  "name": "thefrontierdebate",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tfd-votes",
      // Paste the Database ID from Cloudflare → Storage & databases → D1 → tfd-votes
      "database_id": "3b839a23-1825-45ee-aedd-c0903788d4c0"
    }
  ],
  "observability": { "enabled": true }
}
